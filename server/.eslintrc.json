{
    "root": true,
    "env": {
        "es2024": true,
        "node": true
    },
    "extends": ["eslint:recommended", "prettier"],
    "ignorePatterns": ["logs/", "node_modules/"],
    "parserOptions": {
        "ecmaVersion": "latest",
        "sourceType": "module"
    },
    "rules": {
        "no-console": "error",
        "no-unused-vars": [
            "error",
            {
                "argsIgnorePattern": "^_",
                "caughtErrorsIgnorePattern": "^_",
                "varsIgnorePattern": "^_"
            }
        ]
    }
}

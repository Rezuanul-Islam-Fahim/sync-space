{
    "name": "server",
    "version": "1.0.0",
    "description": "Backend server for a Sync Space built with the MERN stack.",
    "main": "src/bootstrap/server.js",
    "scripts": {
        "start": "node src/bootstrap/server.js",
        "dev": "nodemon src/bootstrap/server.js",
        "lint": "eslint \"src/**/*.js\" \"database/**/*.js\"",
        "lint:fix": "eslint \"src/**/*.js\" \"database/**/*.js\" --fix",
        "format": "prettier \"src/**/*.js\" \"database/**/*.js\" \"*.{js,json,md}\" --write",
        "format:check": "prettier \"src/**/*.js\" \"database/**/*.js\" \"*.{js,json,md}\" --check",
        "db:migrate": "migrate-mongo up",
        "db:migrate:down": "migrate-mongo down",
        "db:migrate:status": "migrate-mongo status",
        "db:seed": "node database/seeds/seeder.js"
    },
    "keywords": [],
    "author": "Rezuanul Islam Fahim",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Rezuanul-Islam-Fahim/sync-space.git"
    },
    "license": "ISC",
    "type": "module",
    "engines": {
        "node": ">=18.0.0"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-validator": "^7.3.2",
        "helmet": "^8.3.0",
        "hpp": "^0.2.3",
        "joi": "^18.2.5",
        "jsonwebtoken": "^9.0.3",
        "migrate-mongo": "^14.0.7",
        "mongoose": "^9.9.3",
        "morgan": "^1.11.0",
        "redis": "^6.2.1",
        "uuid": "^14.0.2",
        "winston": "^3.19.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "eslint": "^10.9.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.11.0",
        "nodemon": "^3.1.14",
        "prettier": "^3.9.6"
    }
}
